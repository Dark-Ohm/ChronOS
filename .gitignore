# Rust / GPUI build output
target/
# Ad-hoc CARGO_TARGET_DIR overrides for one-off debug builds (e.g.
# target-t263-debug/ during T263 investigation) — same junk as target/,
# just not caught by the plain prefix match. 15G+ left untracked once.
target-*/
rust_out

# Nix build outputs
result*

# direnv
.direnv/

# Local reference checkouts (study material, not a dependency; gpui-shell is unlicensed — must not be committed)
reference/

# Git worktrees (isolated workspaces, not part of the repo)
.worktrees/

# Session logs
log-dump/

# Live QA evidence frames (survive reboot, do not commit PNGs)
.chronos-ops/dump/qa-ux/

# lean-ctx / codebase-context cache
contexts/

# Swap/backup файлы редакторов — не под git
*.kate-swp
*.swp
*~

# ── Инструменты агентов ──────────────────────────────────────────────
# Контракт: ОБЩЕЕ (конфиг, хуки, симлинк на вольт скиллов) — под git, чтобы
# у каждого рабочего репо заводилось из коробки с одинаковыми правилами.
# ЛИЧНОЕ (разрешения, кэши, pid/лог/токены живых сессий) — вне git: у каждого
# своё, в мердже даёт только конфликты.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.mimocode/
.autohand/

# Питоновский байткод хуков — генерится под локальную версию интерпретатора
__pycache__/
*.pyc

# Рантайм-состояние брейншторм-сервера superpowers (порт, токен, pid, лог)
.superpowers/brainstorm/

# Сессионные выгрузки design-тула
_ds/
