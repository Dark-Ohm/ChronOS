#!/usr/bin/env bash
# chronos-debug — start ChronOS debug build with hot-reload features.
#
# Builds (if stale) and launches:
#   cargo build -p chronos --features hot-reload
#   RUST_LOG=debug $REPO/target/debug/chronos
#
# This is the runtime context where chronos-reload works.
# Logs to $XDG_STATE_HOME/chronos/chronos-debug.log.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
source "$SCRIPT_DIR/common.sh"

require_not_running

ensure_state_dir

echo "Building chronos (debug + hot-reload)..."
cargo build -p chronos --features hot-reload 2>&1

if [[ ! -x "$DEBUG_BIN" ]]; then
    echo "error: debug binary not found after build: $DEBUG_BIN" >&2
    exit 1
fi

RUST_LOG="${RUST_LOG:-debug}"
export RUST_LOG

echo ""
echo "Starting chronos (debug, RUST_LOG=$RUST_LOG, features=hot-reload)..."
echo "  binary: $DEBUG_BIN"
echo "  log:    $LOG_DEBUG"

nohup "$DEBUG_BIN" >>"$LOG_DEBUG" 2>&1 &
disown
PID=$!

sleep 0.5

if kill -0 "$PID" 2>/dev/null; then
    echo "chronos-debug started (PID $PID)."
else
    echo "error: chronos exited immediately — check $LOG_DEBUG" >&2
    exit 1
fi
